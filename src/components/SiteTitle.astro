---
import { Image } from 'astro:assets';
import logo from '../assets/logo.svg';

const { locale } = Astro.props;
const href = locale ? `/${locale}/` : '/';
---
<a {href} class="site-title sl-flex agentmux-wordmark">
  <Image src={logo} alt="AgentMux" width={32} height={32} class="sl-logo" />
  <span class="sl-site-title-text">
    <span class="sl-site-title-agent">Agent</span>Mux
  </span>
</a>

<style>
  /* Match landing page Nav.tsx: text-xl font-bold tracking-tight gap-2.5 */
  .agentmux-wordmark {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    gap: 0.625rem;
    color: var(--sl-color-white);
    text-decoration: none;
  }
</style>
